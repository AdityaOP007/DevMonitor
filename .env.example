# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=devmonitor

# Application & Testing Flags
ENABLE_TEST_ENDPOINTS=true
SAMPLE_INTERVAL_SECONDS=15
HEALTH_CHECK_INTERVAL_SECONDS=30
TEST_MAX_REQUESTS=1000

# Connection Pool Defaults
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Prometheus Configuration
PROMETHEUS_RETENTION=15d

# Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Alertmanager Configuration File Selection
# Options: alertmanager.yml (default local receiver), alertmanager.slack.example.yml, alertmanager.email.example.yml
ALERTMANAGER_CONFIG=alertmanager.yml

