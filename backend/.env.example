PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devmonitor
CORS_ORIGIN=http://localhost:5173
ENABLE_TEST_ENDPOINTS=true
SAMPLE_INTERVAL_SECONDS=15
HEALTH_CHECK_INTERVAL_SECONDS=30
TEST_MAX_REQUESTS=1000

# PostgreSQL Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Monitored Service Health Probe URLs
# Note: Docker Compose will later override these with internal container service names (e.g. backend, prometheus, grafana)
BACKEND_HEALTH_URL=http://localhost:5000/api/health
FRONTEND_URL=http://localhost:5173
PROMETHEUS_URL=http://localhost:9090/-/healthy
GRAFANA_URL=http://localhost:3000/api/health
